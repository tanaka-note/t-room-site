{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-room-diary",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "routes": [
    {
      "pattern": "tanaka-note.com/diary*",
      "zone_name": "tanaka-note.com"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diary-db",
      "database_id": "e4677259-db4b-4562-ad82-fe542a1edb75",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "t-room-diary-media"
    },
    {
      "binding": "BACKUP",
      "bucket_name": "t-room-diary-backups"
    }
  ],
  "services": [
    {
      "binding": "SECURITY",
      "service": "t-room-security"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SECURITY_AUDIT",
        "queue": "t-room-security-audit"
      }
    ]
  },
  "triggers": {
    "crons": ["25 18 * * *"]
  },
  "vars": {
    "SESSION_TTL_SECONDS": "2592000",
    "PASSKEY_SESSION_TTL_SECONDS": "43200",
    "SESSION_VERSION": "3",
    "PASSKEY_ENABLED": "true"
  }
}
