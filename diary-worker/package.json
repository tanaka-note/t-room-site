{
  "name": "t-room-diary-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node ../tools/sync-web-app-builds.mjs && wrangler deploy",
    "check": "node --check src/index.js && node --check public/diary.js && node --check public/investment.js",
    "test:permissions": "node tests/permissions.e2e.mjs",
    "test:households": "node tests/household-isolation.e2e.mjs",
    "test:favorites": "node tests/favorites.e2e.mjs && node tests/favorites-ui.mjs",
    "test:favorite-browser": "node tests/browser/favorites-flow.mjs",
    "test:trash": "node tests/trash-isolation.e2e.mjs",
    "test:drafts": "node tests/drafts.e2e.mjs && node tests/drafts-ui.mjs",
    "test:initial-password": "node tests/initial-password-ui.mjs",
    "test:search": "node tests/search-ui.mjs",
    "test:monthly": "node tests/monthly-ui.mjs",
    "test:photos": "node tests/photos.e2e.mjs && node tests/photos-ui.mjs",
    "test:photo-editor": "node tests/photo-rich-text-editing-ui.mjs",
    "test:photo-post": "node tests/browser/photo-post-resilience.mjs",
    "test:tags": "node tests/tags-ui.mjs",
    "test:history": "node tests/history-ui.mjs",
    "test:pwa": "node tests/pwa-ui.mjs",
    "test:startup": "node tests/startup-view.mjs",
    "test:scroll-header": "node tests/scroll-header-ui.mjs",
    "test:date-dismiss": "node tests/date-wheel-dismiss-ui.mjs",
    "test:date-input": "node tests/date-input-platform-ui.mjs",
    "test:chiharu-author": "node tests/chiharu-author-ui.mjs",
    "test:rich-text": "node tests/rich-text-ui.mjs",
    "import:investment": "node scripts/import-investment-data.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "wrangler": "^4.34.0"
  }
}
