<Window x:Class="XDownloader.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="X動画ダウンローダー（試作版 0.3）" Width="760" Height="740"
 MinWidth="620" MinHeight="520" FontFamily="Yu Gothic UI" FontSize="14"
 Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="22">
 <DockPanel LastChildFill="True">
  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
   <Button x:Name="LoginButton" Content="Xにログイン" Padding="14,7" Margin="8,0,0,0" Click="Login_Click"/>
   <Button x:Name="LogoutButton" Content="ログアウト" Padding="14,7" Margin="8,0,0,0" Click="Logout_Click"/>
  </StackPanel>
  <TextBlock x:Name="LoginStatus" Text="未ログイン" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </DockPanel>
 <Grid Margin="0,16,0,0" Background="White">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="Xの投稿URL" Margin="0,0,0,6"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="UrlInput" Padding="8" VerticalContentAlignment="Center" TextChanged="Url_Changed"
    AutomationProperties.Name="投稿URL" ToolTip="https://x.com/ユーザー名/status/数字"/>
   <Button x:Name="AnalyzeButton" Grid.Column="1" Content="解析" Padding="22,8" Margin="8,0,0,0" Click="Analyze_Click" IsDefault="True"/>
  </Grid>
  <TextBlock Grid.Row="2" Text="動画" Margin="0,18,0,6"/>
  <ComboBox x:Name="VideoChoice" Grid.Row="3" Padding="6" SelectionChanged="Video_Changed" AutomationProperties.Name="保存する動画"/>
  <TextBlock Grid.Row="4" Text="画質" Margin="0,12,0,6"/>
  <ComboBox x:Name="QualityChoice" Grid.Row="5" Padding="6" AutomationProperties.Name="画質"/>
  <StackPanel Grid.Row="6" Margin="0,12,0,0">
   <TextBlock Text="保存タイトル" Margin="0,0,0,6"/>
   <TextBox x:Name="TitleInput" Padding="7" IsEnabled="False" MaxLength="160" TextChanged="Title_Changed" AutomationProperties.Name="保存タイトル"/>
   <TextBlock Text="先頭に保存日時（秒まで）を付けます：20261017213045_タイトル.mp4"
    Foreground="#555555" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="7" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="保存先" Margin="0,0,0,6"/>
    <TextBox x:Name="FolderInput" Padding="7" IsReadOnly="True" AutomationProperties.Name="保存先"/>
   </StackPanel>
   <Button x:Name="FolderButton" Grid.Column="1" Content="変更…" Padding="16,6" Margin="8,23,0,0" Click="Folder_Click"/>
  </Grid>
  <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,18,0,12">
   <Button x:Name="DownloadButton" Content="選択した動画を保存" Padding="18,8" IsEnabled="False" Click="Download_Click"/>
   <Button x:Name="CancelButton" Content="キャンセル" Padding="16,8" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
   <Button x:Name="OpenFolderButton" Content="保存先を開く" Padding="12,8" Margin="8,0,0,0" Click="OpenFolder_Click"/>
  </StackPanel>
  <ProgressBar x:Name="Progress" Grid.Row="9" Height="8" Minimum="0" Maximum="100"/>
  <StackPanel Grid.Row="10" Margin="0,10,0,0">
   <TextBlock x:Name="Status" Text="投稿URLを入力して「解析」を押してください。" TextWrapping="Wrap" MinHeight="40" AutomationProperties.LiveSetting="Polite"/>
   <TextBox x:Name="SavedFile" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Visibility="Collapsed"/>
  </StackPanel>
  <TextBlock Grid.Row="11" Text="ログイン後は、そのアカウントが閲覧できる投稿を取得します。DM・ライブは対象外です。保存する権利のある動画に使用してください。"
   Foreground="#555555" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
 </Grid>
 </StackPanel>
 </ScrollViewer>
</Window>
