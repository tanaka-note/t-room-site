{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-room-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "tanaka-note.com/ai*",
      "zone_name": "tanaka-note.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-db",
      "database_id": "94d336e3-66c9-4e45-ae23-6ee34a602b05",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "SECURITY",
      "service": "t-room-security"
    }
  ],
  "vars": {
    "SESSION_VERSION": "1",
    "PASSKEY_ENABLED": "true",
    "AI_PROVIDER_MODE": "openai",
    "CHAT_MODEL_DEFAULT": "gpt-5.6-luna",
    "CHAT_MODEL_BALANCED": "gpt-5.6-terra",
    "CHAT_MODEL_ADVANCED": "gpt-5.6-sol",
    "USD_JPY_SAFETY_RATE": "200",
    "MAX_OUTPUT_TOKENS": "900",
    "PASSKEY_SESSION_TTL_SECONDS": "43200"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
