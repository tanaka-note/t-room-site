{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-room-inventory",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "routes": [{ "pattern": "tanaka-note.com/inventory*", "zone_name": "tanaka-note.com" }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "inventory-db", "database_id": "e47d0a7f-7c1b-44b4-98ea-e5db030acd86", "migrations_dir": "migrations" }],
  "services": [{ "binding": "SECURITY", "service": "t-room-security" }],
  "queues": { "producers": [{ "binding": "SECURITY_AUDIT", "queue": "t-room-security-audit" }] },
  "vars": { "SESSION_VERSION": "1", "PASSKEY_ENABLED": "true" },
  "observability": { "enabled": false }
}
