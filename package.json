{
  "scripts": {
    "build": "pnpm run search:index",
    "search:index": "pagefind --site . --glob \"{learning/sharoushi/logs,diary/entries}/[0-9]*.html\" --force-language ja",
    "date-picker:sync": "node tools/sync-troom-date-picker.mjs",
    "date-picker:test": "node tools/test-troom-date-picker.mjs",
    "asset-report:test": "node tools/test-asset-report-history.mjs",
    "brand:test": "node tools/test-brand-naming.mjs",
    "browser-policy:test": "node --test tools/test-line-browser.mjs",
    "browser-policy:test:browser": "node tools/test-line-browser.browser.mjs",
    "password-auth:test": "node --test tools/test-password-auth.mjs",
    "web-apps:sync": "node tools/sync-web-app-builds.mjs",
    "web-apps:test": "node tools/test-web-app-contract.mjs && node tools/test-service-worker-app-shell.mjs && node tools/test-pwa-auto-update.mjs && node tools/test-web-update-blockers.mjs && node tools/test-calculator-fullscreen-layout.mjs",
    "web-apps:verify": "node tools/verify-web-app-builds.mjs",
    "site:prepare": "node tools/prepare-static-assets.mjs",
    "site:deploy": "pnpm run web-apps:sync && pnpm run site:prepare && wrangler deploy",
    "verify": "node tools/verify.mjs --browser --build",
    "verify:changed": "node tools/verify.mjs --changed --browser --build",
    "verify:plan": "node tools/verify.mjs --changed --plan",
    "preview": "node tools/release.mjs preview site",
    "release": "node tools/release.mjs production",
    "local:dev": "node tools/local-dev.mjs",
    "logs:errors": "node tools/worker-logs.mjs",
    "verify:cloud": "node tools/verify.mjs --target cloud --browser --build",
    "verify:security": "node tools/verify.mjs --target security --browser --build",
    "verify:diary": "node tools/verify.mjs --target diary --browser --build",
    "verify:billing": "node tools/verify.mjs --target billing --browser --build",
    "verify:downloader": "node tools/verify.mjs --target downloader --browser --build",
    "verify:ai": "node tools/verify.mjs --target ai --browser --build"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "wrangler": "4.131.1"
  }
}
