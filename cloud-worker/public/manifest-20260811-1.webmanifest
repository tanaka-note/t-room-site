    },
    {
      "src": "/cloud/icons/icon-512-v3.png?rev=20260811-3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/cloud/icons/icon-maskable-512-v3.png?rev=20260811-3",
