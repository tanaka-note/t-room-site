{
  "id": "/cloud/",
  "name": "T-Cloud Storage",
  "short_name": "T-Cloud",
  "description": "写真、動画、音声、書類を安全に保管するプライベートクラウドストレージ。",
  "lang": "ja",
  "dir": "ltr",
  "start_url": "/cloud/?source=pwa",
