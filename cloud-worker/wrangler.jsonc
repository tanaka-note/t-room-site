{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-room-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "routes": [
    {
      "pattern": "tanaka-note.com/cloud*",
      "zone_name": "tanaka-note.com"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-db",
      "database_id": "d536bdb7-c3b4-46df-bdc5-f9ea4f00c4cd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "t-room-cloud-private"
    }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": "2592000",
    "SESSION_VERSION": "3"
  },
  "triggers": {
    "crons": ["17 18 * * *"]
  }
}
