{
  "rules": [
    {
      "id": "downloader-final-failsafe",
      "enabled": true,
      "conditions": {
        "prefix": "downloads/"
      },
      "deleteObjectsTransition": {
        "condition": {
          "maxAge": 3600,
          "type": "Age"
        }
      },
      "abortMultipartUploadsTransition": {
        "condition": {
          "maxAge": 3600,
          "type": "Age"
        }
      }
    }
  ]
}
